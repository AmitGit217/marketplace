model User {
  id            Int      @id
  name          String
  email         String   @unique
  preferences   String?
  sales         Sale[]
  @@map("users")
}

model Vehicle {
  vin               String   @id
  brand             String
  model             String
  type              String
  manufactureYear   Int
  mileage           String
  condition         String
  price             Decimal  @db.Decimal(10, 2)
  acquisitionDate   DateTime
  status            String
  image             String
  color             String
  sale              Sale?
  @@map("vehicles")
}

model Sale {
  id            Int      @id
  saleDate      DateTime
  paymentMethod String
  deliveryDate  DateTime
  userId        Int
  vehicleVin    String   @unique
  user          User     @relation(fields: [userId], references: [id])
  vehicle       Vehicle  @relation(fields: [vehicleVin], references: [vin])

  @@map("sales")
}