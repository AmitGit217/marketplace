datasource db {
  provider = "postgresql"
}
generator client {
  provider = "prisma-client"
  output   = "./generated"
}


model User {
  id            Int      @id
  name          String
  email         String   @unique
  preferences   String?
  sales         Sale[]
  @@map("users")
}

model Vehicle {
  id               String   @id
  brand             String
  model             String
  type              String
  manufactureYear   Int
  mileage           String
  condition         String
  price             Float
  acquisitionDate   DateTime
  status            String
  image             String
  color             String
  sale              Sale?
  @@map("vehicles")
}

model Sale {
  id            Int      @id
  saleDate      DateTime
  paymentMethod String
  deliveryDate  DateTime
  userId        Int
  vehicleId     String   @unique
  user          User     @relation(fields: [userId], references: [id])
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id])

  @@map("sales")
}